<Page x:Class="DrivingSchool.Views.StudentReportsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Отчеты по учащимся">

    <Page.Resources>
        <Style TargetType="TextBlock" x:Key="SummaryTextStyle">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="ValueTextStyle">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
        </Style>
    </Page.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="👨‍🎓 Отчеты по учащимся" 
                   FontSize="20" FontWeight="Bold" 
                   Foreground="#2C3E50" Margin="0,0,0,10"/>

        <GroupBox Grid.Row="1" Header="Фильтры" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Группа:" VerticalAlignment="Center" Margin="5"/>
                <ComboBox Grid.Column="1" x:Name="GroupFilterComboBox"
                         SelectionChanged="FilterComboBox_SelectionChanged" Margin="5"/>

                <TextBlock Grid.Column="2" Text="Пол:" VerticalAlignment="Center" Margin="5"/>
                <ComboBox Grid.Column="3" x:Name="GenderFilterComboBox"
                         SelectionChanged="FilterComboBox_SelectionChanged" Margin="5"/>

                <TextBlock Grid.Column="4" Text="Возраст:" VerticalAlignment="Center" Margin="5"/>
                <ComboBox Grid.Column="5" x:Name="AgeFilterComboBox"
                         SelectionChanged="FilterComboBox_SelectionChanged" Margin="5"/>

                <Button Grid.Column="7" Content="🔄 Обновить" 
                       Click="RefreshButton_Click"
                       Margin="5" Padding="10,5" Background="#3498DB" Foreground="White"/>
            </Grid>
        </GroupBox>

        <TabControl Grid.Row="2" x:Name="ReportsTabControl">

            <TabItem Header="📋 Общий список">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <GroupBox Grid.Row="0" Header="Общая статистика" Margin="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Vertical" Margin="10">
                                <TextBlock Text="Всего студентов" Style="{StaticResource SummaryTextStyle}"/>
                                <TextBlock x:Name="TotalStudentsText" Text="0" Style="{StaticResource ValueTextStyle}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Vertical" Margin="10">
                                <TextBlock Text="Мужчины" Style="{StaticResource SummaryTextStyle}"/>
                                <TextBlock x:Name="MaleCountText" Text="0" Style="{StaticResource ValueTextStyle}" Foreground="#3498DB"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Vertical" Margin="10">
                                <TextBlock Text="Женщины" Style="{StaticResource SummaryTextStyle}"/>
                                <TextBlock x:Name="FemaleCountText" Text="0" Style="{StaticResource ValueTextStyle}" Foreground="#E74C3C"/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" Orientation="Vertical" Margin="10">
                                <TextBlock Text="Средний возраст" Style="{StaticResource SummaryTextStyle}"/>
                                <TextBlock x:Name="AverageAgeText" Text="0" Style="{StaticResource ValueTextStyle}" Foreground="#27AE60"/>
                            </StackPanel>

                            <StackPanel Grid.Column="4" Orientation="Vertical" Margin="10">
                                <TextBlock Text="С документами" Style="{StaticResource SummaryTextStyle}"/>
                                <TextBlock x:Name="WithDocumentsText" Text="0" Style="{StaticResource ValueTextStyle}" Foreground="#9B59B6"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <DataGrid Grid.Row="1" x:Name="StudentsDataGrid" AutoGenerateColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="200"/>
                            <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="120"/>
                            <DataGridTextColumn Header="Возраст" Binding="{Binding Age}" Width="60"/>
                            <DataGridTextColumn Header="Пол" Binding="{Binding Gender}" Width="80"/>
                            <DataGridTextColumn Header="Группа" Binding="{Binding GroupName}" Width="100"/>
                            <DataGridTextColumn Header="Категория" Binding="{Binding CategoryCode}" Width="80"/>
                            <DataGridTextColumn Header="Гражданство" Binding="{Binding Citizenship}" Width="120"/>
                            <DataGridTextColumn Header="Продолжительность" Binding="{Binding StudyDuration}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="📊 Демография">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Распределение студентов по возрасту и полу" 
                              Margin="10" FontWeight="Bold" FontSize="14"/>

                    <DataGrid Grid.Row="1" x:Name="DemographicsDataGrid" AutoGenerateColumns="True"/>
                </Grid>
            </TabItem>

            <TabItem Header="👥 По группам">
                <DataGrid x:Name="GroupsDataGrid" AutoGenerateColumns="True"/>
            </TabItem>

            <TabItem Header="📄 Документы">
                <DataGrid x:Name="DocumentsDataGrid" AutoGenerateColumns="True"/>
            </TabItem>

            <TabItem Header="💰 Финансы">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
                        <TextBlock Text="Статус оплаты:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox x:Name="PaymentStatusComboBox" Width="150"
                                 SelectionChanged="PaymentStatusComboBox_SelectionChanged"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" x:Name="PaymentsDataGrid" AutoGenerateColumns="True"/>
                </Grid>
            </TabItem>

            <TabItem Header="⏱️ Продолжительность">
                <DataGrid x:Name="DurationDataGrid" AutoGenerateColumns="True"/>
            </TabItem>
        </TabControl>
    </Grid>
</Page>