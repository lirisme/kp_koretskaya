<Window x:Class="DrivingSchool.Views.PassportEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Паспортные данные" 
        Height="489" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="3"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="3"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="3"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto" MinHeight="47.96"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Паспортные данные учащегося" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1">
            <GroupBox Header="Тип документа" Margin="0,0,0,10">
                <ComboBox x:Name="DocumentTypeComboBox" 
                          SelectedValue="{Binding DocumentType}"
                          SelectedValuePath="Content">
                    <ComboBoxItem Content="Паспорт РФ"/>
                    <ComboBoxItem Content="Загранпаспорт"/>
                    <ComboBoxItem Content="Вид на жительство"/>
                    <ComboBoxItem Content="Удостоверение личности"/>
                </ComboBox>
            </GroupBox>

            <GroupBox Header="Серия и номер" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Серия*" Margin="5,5,5,0"/>
                    <TextBox Grid.Row="1" Grid.Column="0" x:Name="SeriesTextBox" Text="{Binding Series}" MaxLength="10"/>

                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Номер*" Margin="5,5,5,0"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="NumberTextBox" Text="{Binding Number}" MaxLength="20"/>
                </Grid>
            </GroupBox>

            <GroupBox Header="Орган выдачи" Margin="0,0,0,10">
                <TextBox x:Name="IssuedByTextBox" Text="{Binding IssuedBy}" 
                         TextWrapping="Wrap" Height="60" VerticalScrollBarVisibility="Auto"/>
            </GroupBox>

            <GroupBox Header="Дополнительные данные" Margin="0,0,0,10">
                <Grid Height="56">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Код подразделения" Margin="5,5,5,0"/>
                    <TextBox Grid.Row="1" Grid.Column="0" x:Name="DivisionCodeTextBox" Text="{Binding DivisionCode}" MaxLength="10"/>

                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Дата выдачи*" Margin="5,5,5,0"/>
                    <DatePicker Grid.Row="1" Grid.Column="1" x:Name="IssueDatePicker" SelectedDate="{Binding IssueDate}"/>
                </Grid>
            </GroupBox>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0" Width="180">
            <Button Content="Сохранить" Click="SaveButton_Click" Width="80" Margin="5" Padding="10,5"
                    Background="#2E86AB" Foreground="White"/>
            <Button Content="Отмена" Click="CancelButton_Click" Width="80" Margin="5" Padding="10,5"/>
        </StackPanel>
    </Grid>
</Window>