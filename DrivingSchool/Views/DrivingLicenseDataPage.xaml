<Page x:Class="DrivingSchool.Views.DrivingLicenseDataPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Водительские удостоверения">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F8F9FA" Padding="15" BorderBrush="#BDC3C7" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Поиск учащегося:" 
                          VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold"/>

                <TextBox Grid.Row="0" Grid.Column="1" x:Name="SearchTextBox" 
                        Padding="10,8" FontSize="14"
                        TextChanged="SearchTextBox_TextChanged"
                        ToolTip="Введите ФИО, телефон или ID учащегося..."/>

                <Button Grid.Row="0" Grid.Column="2" Content="Очистить" 
                       Click="ClearSearch_Click" Margin="10,0,0,0" Padding="15,8"
                       ToolTip="Очистить поле поиска"/>

                <ListBox Grid.Row="1" Grid.Column="1" x:Name="SearchResultsListBox"
                        MaxHeight="150" Margin="0,5,0,0"
                        Visibility="Collapsed"
                        SelectionChanged="SearchResultsListBox_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding FullNameWithPhone}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#E8F5E8" Padding="12" Margin="10,5,10,0" 
                BorderBrush="#C8E6C9" BorderThickness="1" CornerRadius="3"
                x:Name="SelectedStudentPanel" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="SelectedStudentText" FontWeight="SemiBold" FontSize="13"/>
                    <TextBlock x:Name="SelectedStudentDetails" FontSize="11" Foreground="#666" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="✕" Click="ClearSelectedStudent_Click" 
                       Width="25" Height="25" Padding="0" FontSize="10"
                       ToolTip="Очистить выбор"
                       Background="Transparent" BorderThickness="1" BorderBrush="#999"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="#FFF3CD" Padding="10" Margin="10,5,10,0" 
                BorderBrush="#FFEEBA" BorderThickness="1" CornerRadius="3"
                x:Name="StatusPanel" Visibility="Visible">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="ℹ️" FontSize="14" Margin="0,0,8,0"/>
                <TextBlock x:Name="StatusTextBlock" TextWrapping="Wrap" FontWeight="SemiBold"
                          Text="Выберите учащегося для работы с водительскими удостоверениями"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Background="White" Padding="10" Margin="10,5,10,5" 
                BorderBrush="#BDC3C7" BorderThickness="0,1,0,1">
            <StackPanel Orientation="Horizontal">
                <Button Content="➕ Добавить удостоверение" Click="AddLicense_Click" Margin="5" Padding="15,8" 
                        Background="#2E86AB" Foreground="White" FontWeight="Bold"
                        x:Name="AddLicenseButton" Height="35"
                        ToolTip="Добавить водительское удостоверение для выбранного учащегося"/>

                <Button Content="✏️ Редактировать" Click="EditLicense_Click" Margin="5" Padding="15,8"
                        Background="#A8D0E6" Foreground="#333333" FontWeight="Bold" Height="35"
                        x:Name="EditLicenseButton"
                        ToolTip="Редактировать выбранное водительское удостоверение"/>

                <Button Content="🗑️ Удалить" Click="DeleteLicense_Click" Margin="5" Padding="15,8"
                        Background="#F76C6C" Foreground="White" FontWeight="Bold" Height="35"
                        x:Name="DeleteLicenseButton"
                        ToolTip="Удалить выбранное водительское удостоверение"/>

                <Separator Margin="20,0" Width="2" Background="#BDC3C7" Height="25"/>

                <Button Content="👁️ Просмотр" Click="ViewLicense_Click" Margin="5" Padding="15,8" Height="35"
                        ToolTip="Просмотреть полную информацию о водительском удостоверении"/>

                <Button Content="🖨️ Печать" Click="PrintLicense_Click" Margin="5" Padding="15,8" Height="35"
                        ToolTip="Распечатать данные водительского удостоверения"/>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="4" x:Name="LicenseGrid" 
                  AutoGenerateColumns="False" 
                  CanUserAddRows="False"
                  CanUserSortColumns="True"
                  SelectionMode="Single"
                  IsReadOnly="True"
                  Margin="10,0,10,10"
                  SelectionChanged="LicenseGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Серия" Binding="{Binding Series}" Width="80"/>
                <DataGridTextColumn Header="Номер" Binding="{Binding Number}" Width="100"/>
                <DataGridTextColumn Header="Категории" Binding="{Binding Categories}" Width="100"/>
                <DataGridTextColumn Header="Кем выдан" Binding="{Binding IssuedBy}" Width="200"/>
                <DataGridTextColumn Header="Дата выдачи" Binding="{Binding IssueDate, StringFormat=dd.MM.yyyy}" Width="100"/>
                <DataGridTextColumn Header="Срок действия" Binding="{Binding ExpiryDate, StringFormat=dd.MM.yyyy}" Width="100"/>
                <DataGridTextColumn Header="Стаж" Binding="{Binding ExperienceYears}" Width="60"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="100">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsExpired}" Value="True">
                                    <Setter Property="Foreground" Value="Red"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsExpired}" Value="False">
                                    <Setter Property="Foreground" Value="Green"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>