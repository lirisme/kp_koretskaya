<Page x:Class="DrivingSchool.Views.TemplatesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Настройка шаблонов документов">

    <Grid Background="White" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Настройка шаблонов документов" 
                   FontSize="20" FontWeight="Bold" Margin="0,0,0,15"
                   Foreground="#2C3E50"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
            <Button Content="➕ Добавить шаблон" 
                    Click="AddTemplate_Click"
                    Padding="15,8" Margin="0,0,10,0"
                    Background="#27AE60" Foreground="White"
                    FontWeight="SemiBold"/>

            <Button Content="✏️ Редактировать" 
                    Click="EditTemplate_Click"
                    Padding="15,8" Margin="0,0,10,0"
                    Background="#3498DB" Foreground="White"
                    FontWeight="SemiBold"/>

            <Button Content="👁️ Просмотреть" 
                    Click="PreviewTemplate_Click"
                    Padding="15,8" Margin="0,0,10,0"
                    Background="#9B59B6" Foreground="White"
                    FontWeight="SemiBold"/>

            <Button Content="🗑️ Удалить" 
                    Click="DeleteTemplate_Click"
                    Padding="15,8" Margin="0,0,10,0"
                    Background="#E74C3C" Foreground="White"
                    FontWeight="SemiBold"/>

            <TextBox x:Name="SearchTextBox" 
                     Width="200" 
                     Padding="10,5"
                     TextChanged="SearchTextBox_TextChanged"
                     ToolTip="Поиск по названию или типу шаблона"/>
        </StackPanel>

        <DataGrid Grid.Row="2" x:Name="TemplatesGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  BorderBrush="#BDC3C7" BorderThickness="1">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding TemplateName}" Width="2*"/>
                <DataGridTextColumn Header="Тип документа" Binding="{Binding DocumentType}" Width="*"/>
                <DataGridTextColumn Header="Файл" Binding="{Binding FilePath}" Width="3*"/>
                <DataGridTextColumn Header="Создан" Binding="{Binding CreatedDate, StringFormat=dd.MM.yyyy}" Width="*"/>
                <DataGridTextColumn Header="Изменен" Binding="{Binding ModifiedDate, StringFormat=dd.MM.yyyy}" Width="*"/>
                <DataGridTextColumn Header="Поля" Binding="{Binding Placeholders.Count}" Width="60"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Background="#ECF0F1" BorderBrush="#BDC3C7" 
                BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="10">
            <TextBlock x:Name="StatusText" Text="Загрузка..." 
                      FontSize="12" Foreground="#7F8C8D"/>
        </Border>
    </Grid>
</Page>