<Page x:Class="DrivingSchool.Views.EmployeesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Сотрудники">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F8F9FA" Padding="10" BorderBrush="#BDC3C7" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="SearchTextBox" Width="300" Padding="5" 
                         TextChanged="SearchTextBox_TextChanged"
                         ToolTip="Поиск по ФИО, должности, телефону..."/>
                <Button Content="Очистить" Click="ClearSearch_Click" Margin="10,0,0,0" Padding="10,5"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="10" Background="White">
            <Button Content="➕ Добавить" Click="AddEmployee_Click" Margin="5" Padding="15,8" 
                    Background="#2E86AB" Foreground="White" FontWeight="Bold"/>
            <Button Content="✏️ Редактировать" Click="EditEmployee_Click" Margin="5" Padding="15,8"
                    Background="#A8D0E6" Foreground="#333333"/>
            <Button Content="🗑️ Удалить" Click="DeleteEmployee_Click" Margin="5" Padding="15,8"
                    Background="#F76C6C" Foreground="White" FontWeight="Bold"/>

            <Separator Margin="20,0" Width="2" Background="#BDC3C7"/>

            <Button Content="👁️ Просмотр" Click="ViewEmployee_Click" Margin="5" Padding="15,8"/>
            <Button Content="📊 Отчет" Click="ExportEmployees_Click" Margin="5" Padding="15,8"/>
        </StackPanel>

        <DataGrid Grid.Row="2" x:Name="EmployeesGrid" 
                  AutoGenerateColumns="False" 
                  CanUserAddRows="False"
                  CanUserSortColumns="True"
                  SelectionMode="Single"
                  IsReadOnly="True"
                  Margin="10,0,10,10"
                  SelectionChanged="EmployeesGrid_SelectionChanged"
                  MouseDoubleClick="EmployeesGrid_MouseDoubleClick">

            <DataGrid.Columns>
                <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="200"/>
                <DataGridTextColumn Header="Должность" Binding="{Binding Position}" Width="150"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="100"/>
                <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="120"/>
                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="180"/>
                <DataGridTextColumn Header="Дата приема" Binding="{Binding HireDate, StringFormat=dd.MM.yyyy}" Width="100"/>
                <DataGridTextColumn Header="Стаж" Binding="{Binding Experience}" Width="80" IsReadOnly="True"/>
            </DataGrid.Columns>

            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="ToolTip">
                        <Setter.Value>
                            <TextBlock>
                                <Run Text="ФИО: "/><Run Text="{Binding FullName}"/><LineBreak/>
                                <Run Text="Должность: "/><Run Text="{Binding Position}"/><LineBreak/>
                                <Run Text="Телефон: "/><Run Text="{Binding Phone}"/><LineBreak/>
                                <Run Text="Статус: "/><Run Text="{Binding Status}"/>
                            </TextBlock>
                        </Setter.Value>
                    </Setter>
                </Style>
            </DataGrid.RowStyle>
        </DataGrid>
    </Grid>
</Page>