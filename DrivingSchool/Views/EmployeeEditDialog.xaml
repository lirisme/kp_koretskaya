<Window x:Class="DrivingSchool.Views.EmployeeEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование сотрудника" 
        Height="500" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="3"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="3"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="3"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Информация о сотруднике" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Header="Основная информация" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="ФИО*" Margin="5,5,5,0"/>
                        <TextBox x:Name="FullNameTextBox" Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="Должность*" Margin="5,10,5,0"/>
                        <ComboBox x:Name="PositionComboBox" 
                                  SelectedValue="{Binding Position, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True">
                            <ComboBoxItem Content="Администратор"/>
                            <ComboBoxItem Content="Преподаватель теории"/>
                            <ComboBoxItem Content="Инструктор по вождению"/>
                            <ComboBoxItem Content="Бухгалтер"/>
                            <ComboBoxItem Content="Руководитель"/>
                            <ComboBoxItem Content="Ответственный за документооборот"/>
                        </ComboBox>

                        <TextBlock Text="Статус*" Margin="5,10,5,0"/>
                        <ComboBox x:Name="StatusComboBox" 
                                  SelectedValue="{Binding Status, UpdateSourceTrigger=PropertyChanged}">
                            <ComboBoxItem Content="Активен"/>
                            <ComboBoxItem Content="Неактивен"/>
                            <ComboBoxItem Content="В отпуске"/>
                            <ComboBoxItem Content="Уволен"/>
                        </ComboBox>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Контактная информация" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Телефон*" Margin="5,5,5,0"/>
                        <TextBox Grid.Row="1" Grid.Column="0" x:Name="PhoneTextBox" 
                                 Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Email" Margin="5,5,5,0"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="EmailTextBox" 
                                 Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Трудоустройство" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Дата приема на работу*" Margin="5,5,5,0"/>
                        <DatePicker x:Name="HireDatePicker" 
                                    SelectedDate="{Binding HireDate, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Сохранить" Click="SaveButton_Click" Width="80" Margin="5" Padding="10,5"/>
            <Button Content="Отмена" Click="CancelButton_Click" Width="80" Margin="5" Padding="10,5"/>
        </StackPanel>
    </Grid>
</Window>