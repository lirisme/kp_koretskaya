<Window x:Class="DrivingSchool.Views.TuitionEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Установка стоимости обучения" 
        Height="550" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="3"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="3"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="5,5,5,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15,15,15,0" Height="494" VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto" MinHeight="47.96"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Стоимость обучения" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1">
            <GroupBox Header="Выбор тарифа" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Тариф*"/>
                    <ComboBox x:Name="TariffComboBox" 
                              SelectionChanged="TariffComboBox_SelectionChanged"
                              ToolTip="Выберите тариф из списка активных"/>

                    <Border Background="#F8F9FA" BorderBrush="#BDC3C7" BorderThickness="1" Margin="0,10,0,0" Padding="10">
                        <TextBlock x:Name="TariffDetailsText" 
                                  TextWrapping="Wrap"
                                  FontSize="11"
                                  Foreground="Gray"/>
                    </Border>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Скидка" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Размер скидки (руб.)"/>
                    <TextBox x:Name="DiscountTextBox" 
                             Text="{Binding Discount, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}"
                             PreviewTextInput="DecimalValidationTextBox"
                             TextChanged="DiscountTextBox_TextChanged"
                             ToolTip="Введите размер скидки (если есть)"/>

                    <Border Background="#E3F2FD" BorderBrush="#90CAF9" BorderThickness="1" Margin="0,10,0,0" Padding="10">
                        <TextBlock x:Name="FinalAmountText" 
                                  FontWeight="Bold" 
                                  FontSize="12" 
                                  Foreground="#1976D2"
                                  Text="Итоговая сумма: 0 руб."/>
                    </Border>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Примечание" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Стоимость обучения устанавливается на основе выбранного тарифа. Скидка применяется к полной стоимости тарифа."
                              TextWrapping="Wrap" 
                              FontStyle="Italic" 
                              Foreground="Gray" Height="63"/>
                </StackPanel>
            </GroupBox>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0" Width="180">
            <Button Content="Сохранить" Click="SaveButton_Click" Width="86" Margin="5" Padding="10,5"
                    Background="#4CAF50" Foreground="White" FontWeight="Bold"/>
            <Button Content="Отмена" Click="CancelButton_Click" Width="80" Margin="5" Padding="10,5"/>
        </StackPanel>
    </Grid>
</Window>