<Page x:Class="DrivingSchool.Views.FinancialReportsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Финансовые отчеты">

    <Page.Resources>
        <Style TargetType="TextBlock" x:Key="SummaryTextStyle">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="ValueTextStyle">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#2C3E50"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="AutoGenerateColumns" Value="True"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
        </Style>
    </Page.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="📊 Финансовые отчеты" 
                   FontSize="20" FontWeight="Bold" 
                   Foreground="#2C3E50" Margin="0,0,0,10"/>

        <GroupBox Grid.Row="1" Header="Параметры отчета" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Период:" 
                           VerticalAlignment="Center" Margin="5"/>
                <ComboBox Grid.Column="1" x:Name="PeriodComboBox"
                         SelectionChanged="PeriodComboBox_SelectionChanged"
                         Margin="5"/>

                <TextBlock Grid.Column="2" Text="С:" 
                           VerticalAlignment="Center" Margin="5"/>
                <DatePicker Grid.Column="3" x:Name="StartDatePicker"
                           IsEnabled="False" Margin="5"/>

                <TextBlock Grid.Column="4" Text="По:" 
                           VerticalAlignment="Center" Margin="5"/>
                <DatePicker Grid.Column="5" x:Name="EndDatePicker"
                           IsEnabled="False" Margin="5"/>

                <Button Grid.Column="6" Content="🔄 Сформировать отчет" 
                       Click="GenerateReportButton_Click"
                       Margin="5" Padding="10,5" Background="#3498DB" Foreground="White"/>
            </Grid>
        </GroupBox>

        <TabControl Grid.Row="2" x:Name="ReportTypeTabControl">

            <TabItem Header="📈 Общий отчет">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <GroupBox Grid.Row="0" Header="Ключевые показатели" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
                                    <StackPanel Orientation="Vertical" Margin="10">
                                        <TextBlock Text="Общий доход" Style="{StaticResource SummaryTextStyle}"/>
                                        <TextBlock x:Name="TotalIncomeText" Text="0 руб." Style="{StaticResource ValueTextStyle}" Foreground="#27AE60"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="1" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
                                    <StackPanel Orientation="Vertical" Margin="10">
                                        <TextBlock Text="Кол-во оплат" Style="{StaticResource SummaryTextStyle}"/>
                                        <TextBlock x:Name="TotalPaymentsText" Text="0" Style="{StaticResource ValueTextStyle}"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
                                    <StackPanel Orientation="Vertical" Margin="10">
                                        <TextBlock Text="Средний чек" Style="{StaticResource SummaryTextStyle}"/>
                                        <TextBlock x:Name="AveragePaymentText" Text="0 руб." Style="{StaticResource ValueTextStyle}"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="3" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
                                    <StackPanel Orientation="Vertical" Margin="10">
                                        <TextBlock Text="Ожидаемый доход" Style="{StaticResource SummaryTextStyle}"/>
                                        <TextBlock x:Name="ExpectedIncomeText" Text="0 руб." Style="{StaticResource ValueTextStyle}"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="4" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
                                    <StackPanel Orientation="Vertical" Margin="10">
                                        <TextBlock Text="Общая задолженность" Style="{StaticResource SummaryTextStyle}"/>
                                        <TextBlock x:Name="TotalDebtText" Text="0 руб." Style="{StaticResource ValueTextStyle}" Foreground="#E74C3C"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="5">
                                    <StackPanel Orientation="Vertical" Margin="10">
                                        <TextBlock Text="Процент оплаты" Style="{StaticResource SummaryTextStyle}"/>
                                        <TextBlock x:Name="PaidPercentageText" Text="0%" Style="{StaticResource ValueTextStyle}" Foreground="#2980B9"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </GroupBox>

                        <GroupBox Grid.Row="1" Header="📅 Динамика оплат по дням" Margin="0,0,0,10">
                            <DataGrid x:Name="PaymentsChart" Height="200"/>
                        </GroupBox>

                        <GroupBox Grid.Row="2" Header="💳 Статистика по типам оплат" Margin="0,0,0,10">
                            <DataGrid x:Name="PaymentTypesDataGrid" Height="150"/>
                        </GroupBox>

                        <GroupBox Grid.Row="3" Header="🕒 Последние оплаты">
                            <DataGrid x:Name="RecentPaymentsDataGrid"/>
                        </GroupBox>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="💰 Отчет по оплатам">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" x:Name="PaymentsSummaryText" 
                              Margin="10,5" FontWeight="Medium" FontSize="14"/>

                    <DataGrid Grid.Row="1" x:Name="PaymentsDataGrid"/>
                </Grid>
            </TabItem>

            <TabItem Header="👨‍🎓 Отчет по студентам">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" x:Name="StudentsSummaryText" 
                              Margin="10,5" FontWeight="Medium" FontSize="14"/>

                    <DataGrid Grid.Row="1" x:Name="StudentsDataGrid"/>
                </Grid>
            </TabItem>

            <TabItem Header="👥 Отчет по группам">
                <DataGrid x:Name="GroupsDataGrid"/>
            </TabItem>
        </TabControl>
    </Grid>
</Page>