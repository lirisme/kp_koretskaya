<Page x:Class="DrivingSchool.Views.CategoriesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Категории ТС">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" Padding="10" Margin="10,5,10,5" 
                BorderBrush="#BDC3C7" BorderThickness="0,1,0,1">
            <StackPanel Orientation="Horizontal">
                <Button Content="➕ Добавить категорию" Click="AddCategory_Click" Margin="5" Padding="15,8" 
                        Background="#2E86AB" Foreground="White" FontWeight="Bold"
                        x:Name="AddCategoryButton" Height="35"
                        ToolTip="Добавить новую категорию ТС"/>

                <Button Content="✏️ Редактировать" Click="EditCategory_Click" Margin="5" Padding="15,8"
                        Background="#A8D0E6" Foreground="#333333" FontWeight="Bold" Height="35"
                        x:Name="EditCategoryButton"
                        ToolTip="Редактировать выбранную категорию"/>

                <Button Content="🗑️ Удалить" Click="DeleteCategory_Click" Margin="5" Padding="15,8"
                        Background="#F76C6C" Foreground="White" FontWeight="Bold" Height="35"
                        x:Name="DeleteCategoryButton"
                        ToolTip="Удалить выбранную категорию"/>

                <Separator Margin="20,0" Width="2" Background="#BDC3C7" Height="25"/>

                <Button Content="👁️ Просмотр" Click="ViewCategory_Click" Margin="5" Padding="15,8" Height="35"
                        ToolTip="Просмотреть информацию о категории"/>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="1" x:Name="CategoriesGrid" 
                  AutoGenerateColumns="False" 
                  CanUserAddRows="False"
                  CanUserSortColumns="True"
                  SelectionMode="Single"
                  IsReadOnly="True"
                  Margin="10,0,10,10"
                  SelectionChanged="CategoriesGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Код" Binding="{Binding Code}" Width="80"/>
                <DataGridTextColumn Header="Название" Binding="{Binding FullName}" Width="*"/>
                <DataGridTextColumn Header="Отображение" Binding="{Binding DisplayText}" Width="200"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>