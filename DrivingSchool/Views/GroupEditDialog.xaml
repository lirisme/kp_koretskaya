<Window x:Class="DrivingSchool.Views.GroupEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование группы" 
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight"
        MinWidth="400"
        Background="White">

    <Border Padding="20" Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                      FontSize="18" FontWeight="Bold" Foreground="#2C3C4D"
                      Margin="0,0,0,20" HorizontalAlignment="Center"/>

            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Номер группы:" 
                          VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox Grid.Column="1" x:Name="NameTextBox" 
                        Text="{Binding StudyGroup.Name}" Padding="8"/>
            </Grid>

            <Grid Grid.Row="2" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Даты обучения:" 
                          VerticalAlignment="Center" FontWeight="SemiBold"/>
                <DatePicker Grid.Column="1" x:Name="StartDatePicker"
                           SelectedDate="{Binding StudyGroup.StartDate}"/>
                <TextBlock Grid.Column="2" Text="—" 
                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <DatePicker Grid.Column="3" x:Name="EndDatePicker"
                           SelectedDate="{Binding StudyGroup.EndDate}"/>
            </Grid>

            <Grid Grid.Row="3" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Статус:" 
                          VerticalAlignment="Center" FontWeight="SemiBold"/>
                <ComboBox Grid.Column="1" x:Name="StatusComboBox"
                         SelectedItem="{Binding StudyGroup.Status}" Padding="8">
                    <ComboBoxItem Content="Активна"/>
                    <ComboBoxItem Content="Завершена"/>
                    <ComboBoxItem Content="Планируется"/>
                </ComboBox>
            </Grid>

            <Border Grid.Row="4" Background="#F8F9FA" BorderBrush="#BDC3C7" 
                    BorderThickness="1" CornerRadius="3" Padding="10" Margin="0,0,0,20">
                <TextBlock x:Name="DurationInfoText" Text="Длительность: расчет..." 
                          FontSize="12" Foreground="#7F8C8D" TextAlignment="Center"/>
            </Border>

            <Grid Grid.Row="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1" x:Name="SaveButton" 
                       Content="💾 Сохранить" 
                       Click="SaveButton_Click"
                       Background="#27AE60" Foreground="White"
                       Padding="15,8" Margin="5,0"/>

                <Button Grid.Column="2" x:Name="CancelButton" 
                       Content="❌ Отмена" 
                       Click="CancelButton_Click"
                       Background="#95A5A6" Foreground="White"
                       Padding="15,8" Margin="5,0"/>
            </Grid>
        </Grid>
    </Border>
</Window>