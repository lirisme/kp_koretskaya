<Page x:Class="DrivingSchool.Views.GroupsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Учебные группы">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F8F9FA" BorderBrush="#BDC3C7" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="10" Height="35">
                <Button Content="➕ Новая" 
                        Click="AddGroup_Click"
                        Width="80" Height="25" Margin="2"
                        ToolTip="Создать новую группу"/>
                <Button Content="✏️ Редакт." 
                        Click="EditGroup_Click"
                        Width="80" Height="25" Margin="2"
                        ToolTip="Редактировать выбранную группу"/>
                <Button Content="👥 Студенты" 
                        Click="ViewStudents_Click"
                        Width="80" Height="25" Margin="2"
                        ToolTip="Просмотр студентов группы"/>
                <Button Content="🗑️ Удалить" 
                        Click="DeleteGroup_Click"
                        Width="80" Height="25" Margin="2"
                        ToolTip="Удалить выбранную группу"/>

                <Separator Margin="15,0" Width="1" Background="#BDC3C7" Height="20"/>

                <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="5,0,5,0"/>
                <TextBox x:Name="SearchTextBox" 
                         Width="180" Height="25" Margin="2"
                         TextChanged="SearchTextBox_TextChanged"
                         ToolTip="Поиск по названию группы или статусу"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="#ECF0F1" BorderBrush="#BDC3C7" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="10" Height="35">
                <Button Content="➕ Добавить студента" 
                        Click="AddStudentToGroup_Click"
                        Width="130" Height="25" Margin="2"
                        Background="#27AE60" Foreground="White"
                        ToolTip="Добавить нового или существующего студента в группу"/>
                <Button Content="↔️ Переместить" 
                        Click="MoveStudentToGroup_Click"
                        Width="100" Height="25" Margin="2"
                        Background="#3498DB" Foreground="White"
                        ToolTip="Переместить студента в выбранную группу"/>
                <Button Content="❌ Удалить" 
                        Click="RemoveStudentFromGroup_Click"
                        Width="80" Height="25" Margin="2"
                        Background="#E74C3C" Foreground="White"
                        ToolTip="Удалить студента из группы"/>
                <Button Content="🔍 Найти группу по студенту" 
                        Click="FindGroupByStudent_Click"
                        Width="177" Height="25" Margin="2"
                        Background="#9B59B6" Foreground="White"
                        ToolTip="Найти группу по студенту"/>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="2" x:Name="GroupsGrid"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  Margin="10">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Группа" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Начало" Binding="{Binding StartDate, StringFormat=dd.MM.yyyy}" Width="100"/>
                <DataGridTextColumn Header="Окончание" Binding="{Binding EndDate, StringFormat=dd.MM.yyyy}" Width="100"/>
                <DataGridTextColumn Header="Длительность" Binding="{Binding Duration}" Width="80"/>
                <DataGridTextColumn Header="Студентов" Binding="{Binding StudentCount}" Width="80"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>