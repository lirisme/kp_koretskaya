<Window x:Class="DrivingSchool.Views.TemplateSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выбор шаблона для студента" 
        WindowStartupLocation="CenterOwner"
        SizeToContent="WidthAndHeight"
        MinWidth="500"
        MinHeight="400"
        Background="White">

    <Border Padding="20" Background="White">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Выбор шаблона документа" 
                      FontSize="18" FontWeight="Bold" Foreground="#2C3C4D"
                      Margin="0,0,0,15" HorizontalAlignment="Center"/>

            <Border Grid.Row="1" Background="#E8F4FD" BorderBrush="#3498DB" 
                    BorderThickness="1" CornerRadius="3" Padding="10" Margin="0,0,0,15">
                <TextBlock x:Name="StudentInfoText" Text="Студент: ..."
                          FontWeight="SemiBold" TextWrapping="Wrap"/>
            </Border>

            <Border Grid.Row="2" BorderBrush="#BDC3C7" BorderThickness="1" 
                    Background="#F8F9FA" Margin="0,0,0,15">
                <DataGrid x:Name="TemplatesGrid"
                         AutoGenerateColumns="False"
                         IsReadOnly="True"
                         SelectionMode="Single"
                         SelectionChanged="TemplatesGrid_SelectionChanged"
                         Margin="5">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Название" Binding="{Binding TemplateName}" Width="2*"/>
                        <DataGridTextColumn Header="Тип" Binding="{Binding DocumentType}" Width="*"/>
                        <DataGridTextColumn Header="Файл" Binding="{Binding FilePath}" Width="3*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Grid Grid.Row="3" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Сохранить как:" 
                          VerticalAlignment="Center" FontWeight="SemiBold"
                          Margin="0,0,10,0"/>

                <TextBox Grid.Column="1" x:Name="OutputPathTextBox" 
                        IsReadOnly="True"
                        Background="#F8F9FA"/>

                <Button Grid.Column="2" Content="📁" 
                        Click="BrowseOutputPath_Click"
                        Margin="10,0,0,0"
                        Background="#3498DB" Foreground="White"
                        Padding="10,5"/>
            </Grid>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1" x:Name="GenerateButton" 
                       Content="🖨️ Сгенерировать" 
                       Click="GenerateButton_Click"
                       Background="#27AE60" Foreground="White"
                       Padding="15,8" Margin="5,0"/>

                <Button Grid.Column="2" x:Name="CancelButton" 
                       Content="❌ Отмена" 
                       Click="CancelButton_Click"
                       Background="#95A5A6" Foreground="White"
                       Padding="15,8" Margin="5,0"/>
            </Grid>
        </Grid>
    </Border>
</Window>