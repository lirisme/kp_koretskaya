<Window x:Class="DrivingSchool.Views.CategoryEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Категория ТС" 
        Height="300" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="3"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Категория транспортного средства" 
                   FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1">
            <GroupBox Header="Код категории*" Margin="0,0,0,10">
                <TextBox x:Name="CodeTextBox" Text="{Binding Code}" MaxLength="5"
                         ToolTip="Буквенный код категории (A, B, C, D, M)"/>
            </GroupBox>

            <GroupBox Header="Полное название*" Margin="0,0,0,10">
                <TextBox x:Name="FullNameTextBox" Text="{Binding FullName}" 
                         ToolTip="Полное название категории"/>
            </GroupBox>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Сохранить" Click="SaveButton_Click" Width="80" Margin="5" Padding="10,5"
                    Background="#2E86AB" Foreground="White"/>
            <Button Content="Отмена" Click="CancelButton_Click" Width="80" Margin="5" Padding="10,5"/>
        </StackPanel>
    </Grid>
</Window>