<Window x:Class="DrivingSchool.Views.PaymentEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Внесение оплаты" 
        Height="400" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="3"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="3"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="3"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Внесение оплаты" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1">
            <GroupBox Header="Информация об оплате" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Дата оплаты*" Margin="5,5,5,0"/>
                    <DatePicker x:Name="PaymentDatePicker" 
                                SelectedDate="{Binding PaymentDate, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Сумма оплаты (руб.)*" Margin="5,10,5,0"/>
                    <TextBox x:Name="AmountTextBox" 
                             Text="{Binding Amount, StringFormat=N2, UpdateSourceTrigger=PropertyChanged}"
                             PreviewTextInput="DecimalValidationTextBox"
                             ToolTip="Внесите сумму оплаты (можно частичную или полную)"/>

                    <TextBlock Text="Тип оплаты*" Margin="5,10,5,0"/>
                    <ComboBox x:Name="PaymentTypeComboBox" 
                              SelectedValue="{Binding PaymentType, UpdateSourceTrigger=PropertyChanged}">
                        <ComboBoxItem Content="Наличные"/>
                        <ComboBoxItem Content="Банковская карта"/>
                        <ComboBoxItem Content="Перевод"/>
                        <ComboBoxItem Content="Электронный платеж"/>
                    </ComboBox>
                </StackPanel>
            </GroupBox>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Сохранить" Click="SaveButton_Click" Width="80" Margin="5" Padding="10,5"/>
            <Button Content="Отмена" Click="CancelButton_Click" Width="80" Margin="5" Padding="10,5"/>
        </StackPanel>
    </Grid>
</Window>