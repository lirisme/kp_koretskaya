<Window x:Class="DrivingSchool.Views.TariffEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование тарифа" 
        Height="500" 
        Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,5,0,10"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,5,0,10"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15,15,15,0" Height="454" VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="Название:"/>
        <TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4"
                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                 MaxLength="100"/>

        <Label Grid.Row="2" Grid.Column="0" Content="Категория:"/>
        <ComboBox Grid.Row="3" Grid.Column="0" 
          SelectedValue="{Binding Category}"
          SelectedValuePath="Content">
            <ComboBoxItem Content="A" IsSelected="True"/>
            <ComboBoxItem Content="B"/>
            <ComboBoxItem Content="C"/>
            <ComboBoxItem Content="D"/>
            <ComboBoxItem Content="M"/>
        </ComboBox>

        <Label Grid.Row="2" Grid.Column="2" Content="Длительность (мес):"/>
        <TextBox Grid.Row="3" Grid.Column="2" 
                 Text="{Binding DurationMonths}"
                 PreviewTextInput="NumberValidationTextBox"/>

        <Label Grid.Row="4" Grid.Column="0" Content="Базовая стоимость:"/>
        <TextBox Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                 Text="{Binding BaseCost, StringFormat=N2}"
                 PreviewTextInput="DecimalValidationTextBox"/>

        <Label Grid.Row="4" Grid.Column="2" Content="Часы практики:"/>
        <TextBox Grid.Row="5" Grid.Column="2" 
                 Text="{Binding PracticeHours}"
                 PreviewTextInput="NumberValidationTextBox"/>

        <Label Grid.Row="6" Grid.Column="0" Content="Включено в тариф:"/>
        <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal">
            <CheckBox Content="Теоретический курс" 
                      IsChecked="{Binding IncludesTheory}"
                      Margin="0,0,20,0"/>
            <CheckBox Content="Практический курс" 
                      IsChecked="{Binding IncludesPractice}"/>
        </StackPanel>

        <Label Grid.Row="8" Grid.Column="0" Content="Описание:"/>
        <TextBox Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="4"
                 Text="{Binding Description}"
                 MaxLength="500"
                 TextWrapping="Wrap"
                 AcceptsReturn="True"
                 Height="80"/>

        <StackPanel Grid.Row="11" Grid.Column="0" Grid.ColumnSpan="4" 
                    Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Сохранить" 
                    Click="SaveButton_Click" 
                    Width="80" 
                    Height="30"
                    Margin="5,0"/>
            <Button Content="Отмена" 
                    Click="CancelButton_Click" 
                    Width="80" 
                    Height="30"
                    Margin="5,0"/>
        </StackPanel>
    </Grid>
</Window>