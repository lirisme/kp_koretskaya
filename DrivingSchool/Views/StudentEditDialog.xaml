<Window x:Class="DrivingSchool.Views.StudentEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование учащегося" 
        Height="722" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="3"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="3"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="3"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15,15,15,13">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Основная информация" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Header="Персональные данные" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Фамилия*" Margin="5,5,5,0"/>
                        <TextBox Grid.Row="1" Grid.Column="0" x:Name="LastNameTextBox" Text="{Binding LastName}"/>

                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Имя*" Margin="5,5,5,0"/>
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="FirstNameTextBox" Text="{Binding FirstName}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Отчество" Margin="5,10,5,0"/>
                        <TextBox Grid.Row="3" Grid.Column="0" x:Name="MiddleNameTextBox" Text="{Binding MiddleName}"/>

                        <TextBlock Grid.Row="2" Grid.Column="1" Text="Пол*" Margin="5,10,5,0"/>
                        <ComboBox Grid.Row="3" Grid.Column="1" x:Name="GenderComboBox" 
                                  SelectedItem="{Binding Gender}">
                            <ComboBoxItem Content="Мужской"/>
                            <ComboBoxItem Content="Женский"/>
                        </ComboBox>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Дата рождения*" Margin="5,10,5,0"/>
                        <DatePicker Grid.Row="5" Grid.Column="0" x:Name="BirthDatePicker" 
                                    SelectedDate="{Binding BirthDate}"/>

                        <TextBlock Grid.Row="4" Grid.Column="1" Text="Гражданство" Margin="5,10,5,0"/>
                        <TextBox Grid.Row="5" Grid.Column="1" x:Name="CitizenshipTextBox" 
                                 Text="{Binding Citizenship}"/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Категория ТС" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Категория транспортного средства*" Margin="5,5,5,0"/>
                        <ComboBox x:Name="CategoryComboBox" DisplayMemberPath="Code"
                                  SelectedValuePath="Id" SelectedValue="{Binding VehicleCategoryId}"
                                  ToolTip="Выберите категорию транспортного средства"/>
                        <TextBlock Text="{Binding ElementName=CategoryComboBox, Path=SelectedItem.FullName}"
                                   Margin="5,2,5,0" FontStyle="Italic" Foreground="Gray" FontSize="10"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Контактная информация" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="Телефон*" Margin="5,5,5,0"/>
                        <TextBox x:Name="PhoneTextBox" Text="{Binding Phone}"/>

                        <TextBlock Text="Email" Margin="5,10,5,0"/>
                        <TextBox x:Name="EmailTextBox" Text="{Binding Email}"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Место рождения" Margin="0,0,0,10">
                    <TextBox x:Name="BirthPlaceTextBox" Text="{Binding BirthPlace}" 
                             TextWrapping="Wrap" Height="41" VerticalScrollBarVisibility="Auto" Margin="5,0,5,0"/>
                </GroupBox>

                <GroupBox Header="Учебная группа" Margin="0,0,0,10">
                    <ComboBox x:Name="GroupComboBox" DisplayMemberPath="Name" 
                              SelectedValuePath="Id" SelectedValue="{Binding GroupId}"/>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Сохранить" Click="SaveButton_Click" Width="80" Margin="5" Padding="10,5"/>
            <Button Content="Отмена" Click="CancelButton_Click" Width="80" Margin="5" Padding="10,5"/>
        </StackPanel>
    </Grid>
</Window>