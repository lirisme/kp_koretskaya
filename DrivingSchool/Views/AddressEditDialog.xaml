<Window x:Class="DrivingSchool.Views.AddressEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Адрес регистрации" 
        Height="576" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="3"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="5,5,5,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto" MinHeight="47.96"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Адрес регистрации учащегося" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1">
            <GroupBox Header="Регион" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Регион*"/>
                    <TextBox x:Name="RegionTextBox" Text="{Binding Region}"/>
                    <TextBlock Text="По умолчанию: Оренбургская область" FontStyle="Italic" Foreground="Gray" FontSize="10"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Населенный пункт*" Margin="0,0,0,10">
                <TextBox x:Name="CityTextBox" Text="{Binding City}"/>
            </GroupBox>

            <GroupBox Header="Улица*" Margin="0,0,0,10">
                <TextBox x:Name="StreetTextBox" Text="{Binding Street}"/>
            </GroupBox>

            <GroupBox Header="Дом и квартира" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Дом*"/>
                    <TextBox Grid.Row="1" Grid.Column="0" x:Name="HouseTextBox" Text="{Binding House}"/>

                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Корпус"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="BuildingTextBox" Text="{Binding Building}"/>

                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Квартира"/>
                    <TextBox Grid.Row="1" Grid.Column="2" x:Name="ApartmentTextBox" Text="{Binding Apartment}"/>
                </Grid>
            </GroupBox>

            <GroupBox Header="Полный адрес (автоматически)" Margin="0,0,0,10">
                <TextBlock x:Name="FullAddressText" Text="{Binding FullAddress}" 
                          TextWrapping="Wrap" Height="83" Padding="5" Background="#F5F5F5" Margin="5,0,5,0"/>
            </GroupBox>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0" Width="180">
            <Button Content="Сохранить" Click="SaveButton_Click" Width="80" Margin="5" Padding="10,5"
                    Background="#2E86AB" Foreground="White"/>
            <Button Content="Отмена" Click="CancelButton_Click" Width="80" Margin="5" Padding="10,5"/>
        </StackPanel>
    </Grid>
</Window>