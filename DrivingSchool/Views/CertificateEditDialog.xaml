<Window x:Class="DrivingSchool.Views.CertificateEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Свидетельство об окончании" 
        Height="400" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="3"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="3"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="3"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="25*"/>
            <ColumnDefinition Width="59*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TitleTextBlock" Text="Свидетельство об окончании" FontWeight="Bold" FontSize="14" Margin="0,0,0,10" Grid.ColumnSpan="2"/>
        
        <StackPanel Grid.Row="1" Grid.ColumnSpan="2">
            <GroupBox Header="Серия и номер свидетельства" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Серия*" Margin="5,5,5,0"/>
                    <TextBox Grid.Row="1" Grid.Column="0" x:Name="SeriesTextBox" 
                             Text="{Binding CertificateSeries}" MaxLength="10"/>

                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Номер*" Margin="5,5,5,0"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="NumberTextBox" 
                             Text="{Binding CertificateNumber}" MaxLength="20"/>
                </Grid>
            </GroupBox>

            <GroupBox Header="Категория ТС" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Категория транспортного средства" Margin="5,5,5,0"/>
                    <TextBox x:Name="CategoryTextBox" IsEnabled="False" 
                 Background="#F5F5F5" Foreground="#666666"
                 ToolTip="Категория автоматически заполняется из данных студента"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Дата выдачи" Margin="0,0,0,10">
                <DatePicker x:Name="IssueDatePicker" SelectedDate="{Binding IssueDate}"/>
            </GroupBox>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0" Grid.Column="1">
            <Button Content="Сохранить" Click="SaveButton_Click" Width="80" Margin="5" Padding="10,5"
                    Background="#2E86AB" Foreground="White"/>
            <Button Content="Отмена" Click="CancelButton_Click" Width="80" Margin="5" Padding="10,5"/>
        </StackPanel>
    </Grid>
</Window>