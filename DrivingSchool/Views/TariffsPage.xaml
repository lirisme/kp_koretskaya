<Page x:Class="DrivingSchool.Views.TariffsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Тарифы">

    <Page.Resources>
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="120"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="5"/>
        </Style>
    </Page.Resources>

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" 
                    Orientation="Horizontal" 
                    Margin="10" 
                    Height="40">
            <Button x:Name="AddTariffButton" Content="Добавить тариф" 
                    Click="AddTariff_Click"
                    Style="{StaticResource ActionButtonStyle}"/>
            <Button x:Name="EditTariffButton" Content="Редактировать" 
                    Click="EditTariff_Click"
                    Style="{StaticResource ActionButtonStyle}"/>
            <Button x:Name="DeleteTariffButton" Content="Удалить тариф" 
                    Click="DeleteTariff_Click"
                    Style="{StaticResource ActionButtonStyle}"/>
            <Button Content="Обновить" 
                    Click="RefreshButton_Click"
                    Style="{StaticResource ActionButtonStyle}"/>
        </StackPanel>

        <DataGrid x:Name="TariffsGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  IsReadOnly="True"
                  Margin="10"
                  SelectionChanged="TariffsGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" 
                                  Binding="{Binding Id}" 
                                  Width="50"/>
                <DataGridTextColumn Header="Название" 
                                  Binding="{Binding Name}" 
                                  Width="200"/>
                <DataGridTextColumn Header="Категория" 
                                  Binding="{Binding Category}" 
                                  Width="80"/>
                <DataGridTextColumn Header="Стоимость" 
                  Binding="{Binding BaseCost, StringFormat='{}{0:N0} ₽'}" 
                  Width="120"/>
                <DataGridTextColumn Header="Длительность" 
                                  Binding="{Binding DurationMonths, StringFormat={}{0} мес.}" 
                                  Width="100"/>
                <DataGridTextColumn Header="Практика" 
                                  Binding="{Binding PracticeHours, StringFormat={}{0} ч.}" 
                                  Width="80"/>
                <DataGridTextColumn Header="Описание" 
                                  Binding="{Binding Description}" 
                                  Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Page>