<Window x:Class="DrivingSchool.Views.MedicalEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Медицинская справка" 
        Height="400" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="3"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="3"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Медицинская справка учащегося" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1">
            <GroupBox Header="Серия и номер справки" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Серия*" Margin="5,5,5,0"/>
                    <TextBox Grid.Row="1" Grid.Column="0" x:Name="SeriesTextBox" Text="{Binding Series}" MaxLength="10"/>

                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Номер*" Margin="5,5,5,0"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="NumberTextBox" Text="{Binding Number}" MaxLength="20"/>
                </Grid>
            </GroupBox>

            <GroupBox Header="Медицинское учреждение*" Margin="0,0,0,10">
                <TextBox x:Name="MedicalInstitutionTextBox" Text="{Binding MedicalInstitution}" 
                         TextWrapping="Wrap" Height="40" VerticalScrollBarVisibility="Auto"/>
            </GroupBox>

            <GroupBox Header="Даты" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Дата выдачи*" Margin="5,5,5,0"/>
                    <DatePicker Grid.Row="1" Grid.Column="0" x:Name="IssueDatePicker" SelectedDate="{Binding IssueDate}"/>

                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Действительна до" Margin="5,5,5,0"/>
                    <DatePicker Grid.Row="1" Grid.Column="1" x:Name="ValidUntilPicker" SelectedDate="{Binding ValidUntil}"/>
                </Grid>
            </GroupBox>

            <GroupBox Header="Регион выдачи" Margin="0,0,0,10">
                <TextBox x:Name="RegionTextBox" Text="{Binding Region}"/>
            </GroupBox>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Сохранить" Click="SaveButton_Click" Width="80" Margin="5" Padding="10,5"
                    Background="#2E86AB" Foreground="White"/>
            <Button Content="Отмена" Click="CancelButton_Click" Width="80" Margin="5" Padding="10,5"/>
        </StackPanel>
    </Grid>
</Window>