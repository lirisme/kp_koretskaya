<Window x:Class="DrivingSchool.Views.SNILSEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Данные СНИЛС" 
        Height="350" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="3"/>
        </Style>
        <Style TargetType="DatePicker">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="3"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Данные СНИЛС учащегося" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1">
            <GroupBox Header="Номер СНИЛС*" Margin="0,0,0,10">
                <TextBox x:Name="NumberTextBox" Text="{Binding Number}" 
                         FontSize="14" FontWeight="SemiBold"
                         ToolTip="Формат: XXX-XXX-XXX XX"/>
            </GroupBox>

            <GroupBox Header="Дата выдачи" Margin="0,0,0,10">
                <DatePicker x:Name="IssueDatePicker" SelectedDate="{Binding IssueDate}"/>
            </GroupBox>

            <GroupBox Header="Кем выдан" Margin="0,0,0,10">
                <TextBox x:Name="IssuedByTextBox" Text="{Binding IssuedBy}" 
                         TextWrapping="Wrap" Height="60" VerticalScrollBarVisibility="Auto"
                         ToolTip="Орган, выдавший СНИЛС (если указан в документе)"/>
            </GroupBox>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Сохранить" Click="SaveButton_Click" Width="80" Margin="5" Padding="10,5"
                    Background="#2E86AB" Foreground="White"/>
            <Button Content="Отмена" Click="CancelButton_Click" Width="80" Margin="5" Padding="10,5"/>
        </StackPanel>
    </Grid>
</Window>