<Page x:Class="DrivingSchool.Views.PaymentsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Платежи"
      Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F8F9FA" Padding="10" BorderBrush="#BDC3C7" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Поиск студента:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="SearchTextBox" Width="300" Padding="5" 
                             TextChanged="SearchTextBox_TextChanged"
                             ToolTip="Поиск по ФИО, телефону или ID студента"/>
                    <Button Content="Очистить" Click="ClearSearch_Click" Margin="10,0,0,0" Padding="10,5"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <ListBox x:Name="SearchResultsListBox" 
                 Grid.Row="1" 
                 MaxHeight="150" 
                 Visibility="Collapsed"
                 SelectionChanged="SearchResultsListBox_SelectionChanged"
                 Margin="10,0,10,0"
                 Background="White"
                 BorderBrush="#BDC3C7"
                 BorderThickness="1">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="5">
                        <TextBlock Text="{Binding FullName}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Phone}" Foreground="Gray"/>
                        <TextBlock Text="{Binding Id, StringFormat='ID: {0}'}" Foreground="DarkGray"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border x:Name="SelectedStudentPanel" 
                Grid.Row="2" 
                Background="#E3F2FD" 
                BorderBrush="#90CAF9" 
                BorderThickness="1" 
                Margin="10" 
                Padding="10"
                Visibility="Collapsed">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <StackPanel>
                        <TextBlock x:Name="SelectedStudentText" FontWeight="Bold" FontSize="14"/>
                        <TextBlock x:Name="SelectedStudentDetails" Foreground="Gray"/>
                    </StackPanel>
                    <Button Content="✕" Click="ClearSelectedStudent_Click" 
                            Margin="20,0,0,0" 
                            Padding="8,2" 
                            Background="Transparent" 
                            BorderBrush="#F44336"
                            Foreground="#F44336"
                            ToolTip="Очистить выбор"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Background="White" Padding="10" BorderBrush="#E0E0E0" BorderThickness="0,1,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#4CAF50" Height="30" CornerRadius="5">
                    <TextBlock x:Name="PaidAmountColorText" Text="Оплачено: 0 руб." 
              HorizontalAlignment="Center" VerticalAlignment="Center" 
              FontWeight="Bold" Foreground="White"/>
                </Border>

                <Border Grid.Column="2" Background="#F44336" Height="30" CornerRadius="5">
                    <TextBlock x:Name="RemainingAmountColorText" Text="Остаток: 0 руб." 
              HorizontalAlignment="Center" VerticalAlignment="Center" 
              FontWeight="Bold" Foreground="White"/>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="4" Background="White" Padding="10" BorderBrush="#E0E0E0" BorderThickness="0,1,0,1">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Стоимость обучения:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>

                    <Button x:Name="SetTuitionButton" Content="💵 Установить стоимость" Click="SetTuitionButton_Click" 
                            Margin="5" Padding="15,8" Width="192"
                            Background="#4CAF50" Foreground="White" FontWeight="Bold"
                            ToolTip="Установить стоимость обучения и скидку"
                            Visibility="Visible"/>

                    <Border x:Name="TuitionDisplayPanel" 
                            Background="#E8F5E8" 
                            BorderBrush="#4CAF50" 
                            BorderThickness="1"
                            Margin="5" 
                            Padding="15,8"
                            Width="160"
                            Visibility="Collapsed"
                            ToolTip="Текущая стоимость обучения (нажмите для изменения)"
                            MouseLeftButtonDown="TuitionDisplayPanel_MouseLeftButtonDown"
                            Cursor="Hand">
                        <StackPanel>
                            <TextBlock x:Name="TuitionDisplayText" 
                                      Text="0 руб." 
                                      FontWeight="Bold" 
                                      Foreground="#2E7D32"
                                      HorizontalAlignment="Center"/>
                            <TextBlock Text="✏️ Изменить" 
                                      FontSize="10" 
                                      Foreground="#666" 
                                      HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Button x:Name="EditTuitionButton" Content="✏️ Изменить стоимость" Click="EditTuitionButton_Click" 
                            Margin="5" Padding="15,8" Width="175"
                            Background="#8BC34A" Foreground="White"
                            ToolTip="Изменить стоимость обучения"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Оплаты:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button x:Name="AddPaymentButton" Content="➕ Добавить оплату" Click="AddPayment_Click" 
                            Margin="5" Padding="15,8" Width="158"
                            Background="#2E86AB" Foreground="White" FontWeight="Bold"
                            ToolTip="Добавить новую оплату"/>

                    <Button x:Name="EditPaymentButton" Content="✏️ Редактировать" Click="EditPayment_Click" 
                            Margin="5" Padding="15,8" Width="140"
                            Background="#A8D0E6" Foreground="#333333"
                            ToolTip="Редактировать выбранную оплату"/>

                    <Button x:Name="DeletePaymentButton" Content="🗑️ Удалить" Click="DeletePayment_Click" 
                            Margin="5" Padding="15,8" Width="120"
                            Background="#F76C6C" Foreground="White" FontWeight="Bold"
                            ToolTip="Удалить выбранную оплату"/>

                    <Separator Margin="20,0" Width="2" Background="#BDC3C7" Height="30" VerticalAlignment="Center"/>

                    <Button Content="👁️ Просмотр" Click="ViewPayment_Click" 
                            Margin="5" Padding="15,8" Width="120"
                            Background="#F8F9FA" Foreground="#333333"
                            ToolTip="Просмотреть детали оплаты"/>

                    <Button Content="📊 Отчет" Click="ExportPayments_Click" 
                            Margin="5" Padding="15,8" Width="100"
                            Background="#F8F9FA" Foreground="#333333"
                            ToolTip="Сформировать отчет"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="5" Background="#F8F9FA" Padding="10" Margin="10" BorderBrush="#BDC3C7" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Стоимость обучения" FontWeight="Bold" FontSize="12" Margin="0,0,0,10"/>

                    <StackPanel x:Name="TuitionInfoPanel" Visibility="Collapsed">
                        <TextBlock x:Name="FullAmountText" FontWeight="SemiBold"/>
                        <TextBlock x:Name="DiscountText" Foreground="Gray"/>
                        <TextBlock x:Name="FinalAmountText" FontWeight="Bold" FontSize="14" Foreground="#2E86AB" Margin="0,5,0,0"/>
                    </StackPanel>

                    <TextBlock x:Name="NoTuitionText" Text="Стоимость обучения не установлена" 
                               FontStyle="Italic" Foreground="Gray" Visibility="Visible"/>
                </StackPanel>

                <Separator Grid.Column="1" Width="2" Background="#BDC3C7" Margin="20,0" HorizontalAlignment="Center"/>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Прогресс оплат" FontWeight="Bold" FontSize="12" Margin="0,0,0,10"/>

                    <TextBlock x:Name="TotalAmountText" FontWeight="SemiBold" FontSize="12"/>
                    <Border BorderThickness="1" BorderBrush="#BDBDBD" Height="25" Margin="0,5,0,0" Background="#F5F5F5">
                        <Grid x:Name="ProgressBarGrid">
                            <Border x:Name="PaidAmountBar" Background="#4CAF50" HorizontalAlignment="Left" 
                                    Height="23" Margin="1"/>
                            <TextBlock x:Name="ProgressText" HorizontalAlignment="Center" VerticalAlignment="Center" 
                                      FontWeight="Bold" Foreground="Black" Text="0%"/>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="PaymentDetailsText" Margin="0,5,0,0" FontWeight="SemiBold"/>
                    <TextBlock x:Name="RemainingAmountText" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>

        <DataGrid Grid.Row="6" x:Name="PaymentsGrid" 
                  AutoGenerateColumns="False" 
                  CanUserAddRows="False"
                  CanUserSortColumns="True"
                  SelectionMode="Single"
                  IsReadOnly="True"
                  Margin="10"
                  SelectionChanged="PaymentsGrid_SelectionChanged"
                  Background="White"
                  BorderBrush="#E0E0E0"
                  BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="40"/>
                <DataGridTextColumn Header="Дата оплаты" Binding="{Binding PaymentDate, StringFormat=dd.MM.yyyy}" Width="90"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding Amount, StringFormat=N2}" Width="80"/>
                <DataGridTextColumn Header="Тип оплаты" Binding="{Binding PaymentType}" Width="100"/>
                <DataGridTextColumn Header="Статус" Width="80">
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Background" Value="{Binding StatusColor}"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.CellStyle>
                    <DataGridTextColumn.Binding>
                        <Binding Path="StatusText"/>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>