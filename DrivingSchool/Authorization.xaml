<Window x:Class="DrivingSchool.Authorization"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DrivingSchool"
        mc:Ignorable="d"
               Title="Авторизация и регистрация"
        Height="500" Width="350" 
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Grid>

        <Rectangle Fill="#FFF0F4FF" Opacity="0.1"/>

        <TabControl x:Name="tabControl" Background="Transparent" BorderThickness="0" FontFamily="Segoe UI" FontSize="14">
            <TabItem Header="Вход" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10" VerticalAlignment="Top">
                        <TextBlock Text="Роль" Margin="0,10,0,5" FontWeight="SemiBold" Foreground="#FF4A6FA5"/>
                        <ComboBox x:Name="RoleComboBox" SelectedIndex="0" Background="#FFF0F8FF" BorderBrush="#FFB3CDE0" BorderThickness="1" Padding="6">
                            <ComboBoxItem Content="Пользователь" />
                            <ComboBoxItem Content="Админ" />
                        </ComboBox>

                        <TextBlock Text="Логин" Margin="0,10,0,5" FontWeight="SemiBold" Foreground="#FF4A6FA5"/>
                        <TextBox x:Name="LoginBox" Background="#FFF0F8FF" BorderBrush="#FFB3CDE0" BorderThickness="1" Padding="6" />

                        <TextBlock Text="Пароль" Margin="0,10,0,5" FontWeight="SemiBold" Foreground="#FF4A6FA5"/>
                        <PasswordBox x:Name="PasswordBox" Background="#FFF0F8FF" BorderBrush="#FFB3CDE0" BorderThickness="1" Padding="6"/>

                        <StackPanel x:Name="CaptchaPanel" Margin="0,20,0,0" Visibility="Collapsed">
                            <TextBlock Text="Введите символы с картинки" Margin="0,0,0,5" FontWeight="SemiBold" Foreground="#FF4A6FA5"/>
                            <Image x:Name="CaptchaImage" Height="70" Width="200" Margin="0,0,0,5" />

                            <Grid Height="30" Width="200">
                                <TextBox x:Name="CaptchaInputBox"
                                         Padding="5"
                                         Background="#FFF0F8FF"
                                         BorderBrush="#FFB3CDE0"
                                         BorderThickness="1"
                                         VerticalContentAlignment="Center"
                                         TextChanged="CaptchaInputBox_TextChanged"/>
                                <TextBlock x:Name="CaptchaPlaceholder"
                                           Text="Введите капчу"
                                           Foreground="Gray"
                                           Margin="8,0,0,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Visibility="Visible"/>
                            </Grid>
                        </StackPanel>

                        <Button Content="Войти"
                                Margin="0,20,0,0"
                                Background="#FFB3CDE0"
                                Foreground="White"
                                Click="Login_Click"
                                Padding="8"
                                BorderBrush="Transparent"
                                FontWeight="Bold"
                                Cursor="Hand"
                                HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Регистрация" Padding="10">
                <StackPanel Margin="10" VerticalAlignment="Center">
                    <TextBlock Text="Выберите роль" Margin="0,5" FontWeight="SemiBold" Foreground="#FFCC5A71"/>
                    <ComboBox x:Name="RegRoleComboBox" SelectedIndex="0" Background="#FFFFF0F5" BorderBrush="#FFFFB6C1" BorderThickness="1" Padding="6">
                        <ComboBoxItem Content="Пользователь"/>
                        <ComboBoxItem Content="Админ"/>
                    </ComboBox>

                    <TextBlock Text="Пароль администратора для регистрации" Margin="0,0,0,2"/>
                    <PasswordBox x:Name="AdminPasswordBox" Margin="0,0,0,10"/>

                    <TextBlock Text="Придумайте логин" Margin="0,5" FontWeight="SemiBold" Foreground="#FFCC5A71"/>
                    <TextBox x:Name="RegLoginBox" Background="#FFFFF0F5" BorderBrush="#FFFFB6C1" BorderThickness="1" Padding="6"/>

                    <TextBlock Text="Придумайте пароль" Margin="0,10,0,5" FontWeight="SemiBold" Foreground="#FFCC5A71"/>
                    <PasswordBox x:Name="RegPasswordBox" Background="#FFFFF0F5" BorderBrush="#FFFFB6C1" BorderThickness="1" Padding="6"/>

                    <Button Content="Зарегистрироваться"
                            Margin="0,20,0,0"
                            Background="#FFFFB6C1"
                            Foreground="White"
                            Click="Register_Click"
                            Padding="8"
                            BorderBrush="Transparent"
                            FontWeight="Bold"
                            Cursor="Hand"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>