<Window x:Class="DrivingSchool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Элита Авто: Учебный Центр" 
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">

    <Window.Resources>
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F0F0"/>
                    <Setter Property="Foreground" Value="#0066CC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WindowControlButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="35"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#404040"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CloseButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowControlButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#2C3E50">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Элита Авто: Автоматизированная система управления" 
                          Foreground="White" FontSize="12" FontWeight="Bold"
                          VerticalAlignment="Center" Margin="10,0,0,0"
                          MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="MinimizeButton" Content="_" 
                            Style="{StaticResource WindowControlButtonStyle}"
                            Click="MinimizeButton_Click"
                            ToolTip="Свернуть"/>

                    <Button x:Name="MaximizeButton" Content="❐" 
                            Style="{StaticResource WindowControlButtonStyle}"
                            Click="MaximizeButton_Click"
                            ToolTip="Развернуть"
                            Margin="2,0,0,0"/>

                    <Button x:Name="CloseButton" Content="✕" 
                            Style="{StaticResource CloseButtonStyle}"
                            Click="CloseButton_Click"
                            ToolTip="Закрыть"
                            Margin="2,0,2,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Menu Grid.Row="1" Grid.ColumnSpan="2" Background="#F8F9FA">
            <MenuItem Header="Файл">
                <MenuItem Header="Выход" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="Справочники">
                <MenuItem Header="Сотрудники" Click="Employees_Click"/>
                <MenuItem Header="Учащиеся" Click="Students_Click"/>
                <MenuItem Header="Паспортные данные" Click="PassportData_Click"/>
                <MenuItem Header="Адреса регистрации" Click="AddressData_Click"/>
                <MenuItem Header="Данные СНИЛС" Click="SNILSData_Click"/>
                <MenuItem Header="Медицинские справки" Click="MedicalData_Click"/>
                <MenuItem Header="Свидетельства об окончании" Click="CertificateData_Click"/>
                <MenuItem Header="Водительские удостоверения" Click="DrivingLicenseData_Click"/>
                <MenuItem Header="Учебные группы" Click="Groups_Click"/>
                <MenuItem Header="Тарифы" Click="Rates_Click"/> 
                <MenuItem Header="Категории ТС" Click="Categories_Click"/>
                
            </MenuItem>

            <MenuItem Header="Документы">
                <MenuItem Header="Договоры" Click="Contracts_Click"/>
                <MenuItem Header="Заявления в ГИБДД" Click="GIBDD_Applications_Click"/>
                <Separator/>
                <MenuItem Header="Настройка шаблонов" Click="Templates_Click"/>
            </MenuItem>
            <MenuItem Header="Отчеты">
                <MenuItem Header="Отчеты по учащимся" Click="StudentReports_Click"/>
                <MenuItem Header="Финансовые отчеты" Click="FinancialReports_Click"/>
                <MenuItem Header="Ведомость по задолженностям" Click="DebtsReport_Click"/>
            </MenuItem>
            <MenuItem Header="Сервис">
                <MenuItem Header="Резервное копирование" Click="Backup_Click"/>
                <MenuItem Header="Настройки" Click="Settings_Click"/>
            </MenuItem>
            <MenuItem Header="Помощь">
                <MenuItem Header="О программе" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <ToolBar Grid.Row="2" Grid.ColumnSpan="2" Background="#ECF0F1">
            <Button Content="Учащиеся" Click="Students_Click" ToolTip="Список учащихся"/>
            <Separator/>
            <Button Content="Группы" Click="Groups_Click" ToolTip="Учебные группы"/>
            <Button Content="Платежи" Click="Payments_Click" ToolTip="Внесение платежей"/>
            <Separator/>
            <Button Content="Договор" Click="NewContract_Click" ToolTip="Новый договор"/>
            <Button Content="Отчет" Click="QuickReport_Click" ToolTip="Быстрый отчет"/>
        </ToolBar>

        <Border Grid.Row="3" Grid.Column="0" BorderBrush="#BDC3C7" BorderThickness="0,1,1,0">
            <StackPanel Background="#F8F9FA">
                <TextBlock Text="НАВИГАЦИЯ" FontWeight="Bold" Margin="15,20,15,10" Foreground="#7F8C8D"/>

                <Button Content="📊 Панель управления" Style="{StaticResource NavButtonStyle}" 
                        Click="Dashboard_Click" Tag="Dashboard"/>

                <TextBlock Text="Учебный процесс" FontWeight="SemiBold" Margin="15,20,15,5" Foreground="#7F8C8D"/>
                <Button Content="👥 Учащиеся" Style="{StaticResource NavButtonStyle}" 
                        Click="Students_Click" Tag="Students"/>
                <Button Content="📚 Учебные группы" Style="{StaticResource NavButtonStyle}" 
                        Click="Groups_Click" Tag="Groups"/>

                <TextBlock Text="Документы и финансы" FontWeight="SemiBold" Margin="15,20,15,5" Foreground="#7F8C8D"/>
                <Button Content="📄 Договоры" Style="{StaticResource NavButtonStyle}" 
                        Click="Contracts_Click" Tag="Contracts"/>
                <Button Content="💰 Платежи" Style="{StaticResource NavButtonStyle}" 
                        Click="Payments_Click" Tag="Payments"/>

                <TextBlock Text="Отчетность" FontWeight="SemiBold" Margin="15,20,15,5" Foreground="#7F8C8D"/>
                <Button Content="📈 Финансовые отчеты" Style="{StaticResource NavButtonStyle}" 
                        Click="FinancialReports_Click" Tag="FinanceReports"/>
                <Button Content="📋 Ведомость задолженностей" Style="{StaticResource NavButtonStyle}" 
                        Click="DebtsReport_Click" Tag="Debts"/>
                <Button Content="👤 Отчеты по учащимся" Style="{StaticResource NavButtonStyle}" 
                        Click="StudentReports_Click" Tag="StudentReports"/>
            </StackPanel>
        </Border>

        <Frame Grid.Row="3" Grid.Column="1" 
               x:Name="MainContentFrame" 
               NavigationUIVisibility="Hidden"
               Background="White"/>

        <StatusBar Grid.Row="4" Grid.ColumnSpan="2" Background="#34495E">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Готов" Foreground="White"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="UserInfoText" Text="Пользователь: " Foreground="White"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="DateTimeText" Foreground="White"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>